# --- OpenAI Chat ---
OPENAI_API_KEY=dummy
CHAT_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3:4b

# --- Embedding Model ---
EMBEDDING_API_KEY=dummy
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma

# --- Redis Vector Store (domyślny) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_INDEX=documents

# --- Qdrant Vector Store (alternatywa: VECTOR_STORE=qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=documents
QDRANT_TLS=false
# QDRANT_API_KEY=jesli_uzywasz_clouda

# --- RAG Configuration ---
CHUNK_SIZE=512
MIN_CHUNK_SIZE=128
CHUNK_OVERLAP=50
TOP_K=5
SIMILARITY_THRESHOLD=0.5
